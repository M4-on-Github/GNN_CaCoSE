Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

# CaCoSE runtime container.
#
# Dependencies only -- the code is NOT baked in. The repo is bind-mounted from
# /home/$USER/CaCoSE at run time, so editing code never requires a rebuild. Rebuild this
# image only when pyproject.toml's dependencies change.
#
# The versions below must match pyproject.toml exactly. That is what makes "tests pass
# locally" mean anything about a cluster run.
#
#   torch 2.5.1  - not 2.4.0. The 2.4.0 build corrupts the heap across repeated
#                  torch_geometric scatter calls; 2.5.1 does not.
#   numpy < 2    - torch wheels are built against the NumPy 1.x C API. With NumPy 2 the
#                  import succeeds and every interop call then fails at runtime.
#   scipy        - PyG's Planetoid and TUDataset readers unpickle scipy sparse matrices.
#
# Deliberately absent: torch_scatter, torch_sparse, pyg_lib. PyG >= 2.4 has pure-torch
# fallbacks for everything CaCoSE uses, and those three compiled packages are the usual
# cause of a failed build.
#
# cu121 covers every GPU in the pleiades cluster: GTX 1080Ti (sm_61), Quadro RTX 6000
# (sm_75) and RTX 6000 Ada (sm_89).

%post
    # Make `python` resolve at exec time. The base image only guarantees it via Docker's ENV
    # PATH, which Apptainer applies during %post and %test but NOT to `apptainer exec` -- so
    # without this, every job dies with: "python": executable file not found in $PATH.
    # /usr/local/bin is on Apptainer's default PATH, so a symlink there is more robust than
    # exporting PATH alone (both are done).
    command -v python >/dev/null 2>&1 || ln -sf "$(command -v python3)" /usr/local/bin/python

    pip install --no-cache-dir \
        "numpy<2" \
        "scipy" \
        "torch-geometric==2.6.1" \
        "networkx>=3.0" \
        "pyyaml>=6.0" \
        "pytest>=8.0" \
        "ruff>=0.6"

%environment
    # The base image installs Python under /opt/conda via Docker's ENV PATH. Apptainer applies
    # that during %post and %test but NOT to `apptainer exec`, so without this line every
    # `exec ... python` fails with: "python": executable file not found in $PATH.
    export PATH=/opt/conda/bin:${PATH}
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%test
    # Runs at the end of `apptainer build`. Fails the build rather than failing a job later.
    #
    # Written as `python -c` with the source starting at column 0. A heredoc here does not work:
    # the %test body is indented for readability, and those leading spaces reach the interpreter
    # verbatim, so Python rejects the whole script with IndentationError.
    python -c "
import numpy, scipy, torch, torch_geometric
from torch_geometric.nn import GCNConv, SAGPooling, global_mean_pool
assert numpy.__version__.startswith('1.'), 'numpy must be 1.x, got ' + numpy.__version__
assert torch.arange(3.0).numpy().sum() == 3.0, 'torch<->numpy interop is broken'
print('torch', torch.__version__, '| pyg', torch_geometric.__version__, '| numpy', numpy.__version__, '| scipy', scipy.__version__)
print('cuda available:', torch.cuda.is_available())
print('stack OK')
"

%labels
    Name cacose
    Description CaCoSE reproduction runtime (dependencies only)

%help
    Dependencies for the CaCoSE package. The code lives on the host.

    Build (on a compute node, not head1):
        srun -p pleiades --gpus=1 --time=1:00:00 --pty bash
        apptainer build /data/$USER/CaCoSE/containers/cacose.sif slurm/cacose.def

    Run:
        apptainer exec --nv --bind /data/$USER/CaCoSE \
            /data/$USER/CaCoSE/containers/cacose.sif \
            python -m scripts.run --config configs/cora.yaml --seed 0
